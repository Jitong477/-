# OPENAI_API_KEY: Required for custom OpenAI proxy calling API.
# Users configure this via the Secrets panel in the AI Studio UI.
OPENAI_API_KEY="YOUR_KEY"

# Optional: Custom base URL of your OpenAI compatible API proxy. Defaults to https://api.openai-next.com/v1
OPENAI_BASE_URL="https://api.openai-next.com/v1"

# Optional: Custom model identifier. Defaults to gpt-4
OPENAI_MODEL="gpt-4"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
